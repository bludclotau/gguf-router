[Unit]
Description=GGUF Router Service
After=network.target postgresql-16.service

[Service]
WorkingDirectory=/home/snerloc/gguf-router/router
ExecStart=/home/snerloc/.local/bin/uvicorn main:app --host 0.0.0.0 --port 9000
Restart=always
User=snerloc
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/snerloc/gguf-router/.env

[Install]
WantedBy=multi-user.target
